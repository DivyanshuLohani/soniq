generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  USER
  ADMIN
}

enum FriendshipStatus {
  PENDING
  ACCEPTED
  DECLINED
  BLOCKED
}

model User {
  id           String        @id @default(cuid())
  email        String?       @unique
  passwordHash String?
  displayName  String
  role         Role          @default(USER)
  avatarUrl    String?
  spotifyId    String?       @unique
  spotifyUri   String?
  spotifyProduct String?
  accessToken  String?
  refreshToken String?
  showInSearch  Boolean       @default(true)
  tokenExpiry  DateTime?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  sessions     GameSession[]
  events       AnalyticsEvent[]

  sentFriendRequests     Friendship[] @relation("SentFriendRequests")
  receivedFriendRequests Friendship[] @relation("ReceivedFriendRequests")

  @@index([email])
  @@index([role])
}

model Friendship {
  id          String           @id @default(cuid())
  senderId    String
  sender      User             @relation("SentFriendRequests", fields: [senderId], references: [id], onDelete: Cascade)
  receiverId  String
  receiver    User             @relation("ReceivedFriendRequests", fields: [receiverId], references: [id], onDelete: Cascade)
  status      FriendshipStatus @default(PENDING)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@unique([senderId, receiverId])
  @@index([senderId])
  @@index([receiverId])
  @@index([status])
}

model GameSession {
  id               String       @id @default(cuid())
  userId           String?
  user             User?        @relation(fields: [userId], references: [id], onDelete: SetNull)
  guestName        String?
  artistId         String
  artistName       String
  artistImage      String?
  totalQuestions   Int
  correctCount     Int
  score            Int
  timeTakenSeconds Float
  accuracy         Float
  answers          GameAnswer[]
  createdAt        DateTime     @default(now())

  @@index([artistName])
  @@index([score])
  @@index([timeTakenSeconds])
  @@index([createdAt])
}

model GameAnswer {
  id                String      @id @default(cuid())
  sessionId         String
  session           GameSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  questionIndex     Int
  trackId           String
  trackName         String
  selectedTrackId   String
  selectedTrackName String
  isCorrect         Boolean
  timeSpentSeconds  Float

  @@index([sessionId])
  @@index([isCorrect])
}

model AnalyticsCache {
  id                 String   @id @default(cuid())
  key                String   @unique
  data               String   // JSON stringified aggregated data
  computationTimeMs  Float    @default(0)
  lastUpdated        DateTime @default(now())
  expiresAt          DateTime

  @@index([key])
  @@index([expiresAt])
}

model AnalyticsEvent {
  id         String   @id @default(cuid())
  eventType  String   // 'page_view', 'quiz_start', 'quiz_complete', 'artist_search', 'auth_login'
  userId     String?
  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  artistId   String?
  artistName String?
  metadata   String?  // JSON stringified payload
  createdAt  DateTime @default(now())

  @@index([eventType])
  @@index([artistName])
  @@index([createdAt])
}

model FeaturedArtist {
  id           String   @id @default(cuid())
  artistId     String   @unique
  name         String
  imageUrl     String
  genres       String   @default("")
  popularity   Int      @default(90)
  displayOrder Int      @default(0)
  isActive     Boolean  @default(true)
  customSongs  String?  // JSON array of track names or preview overrides
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([displayOrder])
  @@index([isActive])
}

model FeaturedTrack {
  id           String   @id @default(cuid())
  title        String
  artistName   String
  albumName    String?
  albumCover   String?
  previewUrl   String?
  spotifyUri   String?
  displayOrder Int      @default(0)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([displayOrder])
  @@index([isActive])
}

